# NEXUS — Environment Variables Template
# Copy to .env.local and fill in your values.
#
# The app reads exactly two variables. Both are prefixed VITE_, so both are
# embedded in the browser bundle: never put a secret here. The anon key is
# public by design and protected by Row Level Security.
#
# Edge-function secrets (SUPABASE_URL, SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY) are provided by Supabase to the functions and are
# never set in this file. The login-code cipher key is derived from the
# service-role key, so rotating that key invalidates stored login codes.

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
